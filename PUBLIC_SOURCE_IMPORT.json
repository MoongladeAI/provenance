  "wasm_provenance": {
    "summary": "All four wasm/ files were reproduced byte for byte on 2026-10-24 from a clean git archive export of the private monorepo. No file is hand-edited.",
    "source_repo": "moonglade-provenance (private monorepo; crates/mgc-wasm and crates/mgc-core)",
    "source_commit": "84ff58c679c64c723f91b101012e7ba884e93020",
    "source_commit_note": "Last commit that touched crates/, Cargo.lock and rust-toolchain.toml. Private main fca58c81e59d6f106da5552aaa7e24dee5d949e1 has identical trees for all three (crates d14e94c9..., Cargo.lock 67adb47b..., rust-toolchain.toml 68c0ea29...). The private working tree had no uncommitted changes under crates/ at verification time; build-time state was inferred from file mtimes (sources 2026-10-22, build output 2026-10-23 20:58) and the byte-identical rebuild.",
    "toolchain": "rustc 1.98.1 (48a229cea 2026-09-01), pinned by rust-toolchain.toml; target wasm32-unknown-unknown",
    "wasm_bindgen_version": "0.2.129 (wasm-bindgen CLI 0.2.129, equal to the Cargo.lock crate version)",
    "wasm_opt": "not applied: the bytes reproduce without it",
    "wasm_pack": "Agy reports building with wasm-pack build --target nodejs --release. wasm-pack was not installed or run here; the equivalent cargo + wasm-bindgen steps below reproduce the shipped bytes.",
    "build_commands": [
      "git archive 84ff58c | tar -x   (into an empty temp directory)",
      "cargo build --locked --release --target wasm32-unknown-unknown -p mgc-wasm",
      "wasm-bindgen --target nodejs --out-dir <out> target/wasm32-unknown-unknown/release/mgc_wasm.wasm"
    ],
